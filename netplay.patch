@@ -37,7 +37,8 @@
         /* ---------------------------------------------------------------- */
         /*  Merge all of the keypad / action key inputs to the controller.  */
         /* ---------------------------------------------------------------- */
-        const uint32_t *const event_inputs = side_idx == 0 ? pad->r : pad->l;
+        const uint32_t *const event_inputs = pad->net ? (side_idx == 0 ? pad->nr : pad->nl)
+                                                      : (side_idx == 0 ? pad->r  : pad->l );
         uint32_t merged_inputs = 0;
         for (int i = 0; i < 15; i++)
             merged_inputs |= event_inputs[i];
@@ -506,3 +507,41 @@
 /* ======================================================================== */
 /*                 Copyright (c) 1998-2020, Joseph Zbiciak                  */
 /* ======================================================================== */
+
+/* ======================================================================== */
+/*  NETPLAY GLUE -- called by the STIC once per frame.                      */
+/* ======================================================================== */
+#include "netplay/netplay.h"
+#include <string.h>
+
+static pad_t *np_pad = NULL;
+
+void pad_netplay_attach(pad_t *pad) { np_pad = pad; }
+
+void pad_netplay_frame(uint64_t cycle)
+{
+    if (!np_pad) return;
+    if (!netplay_active())
+    {
+        if (np_pad->net) { np_pad->net = false; np_pad->stale = true; }
+        return;
+    }
+
+    /* Local player always uses the normal "player 1" (right) controls.    */
+    uint8_t local[NP_INPUT_BYTES], out_r[NP_INPUT_BYTES], out_l[NP_INPUT_BYTES];
+    for (int i = 0; i < 15; i++) local[i] = (uint8_t)np_pad->r[i];
+    local[15] = (uint8_t)np_pad->r[17];
+
+    if (!netplay_frame((uint32_t)cycle, local, out_r, out_l))
+    {
+        np_pad->net = false; np_pad->stale = true;
+        return;
+    }
+
+    memset(np_pad->nr, 0, sizeof np_pad->nr);
+    memset(np_pad->nl, 0, sizeof np_pad->nl);
+    for (int i = 0; i < 15; i++) { np_pad->nr[i] = out_r[i]; np_pad->nl[i] = out_l[i]; }
+    np_pad->nr[17] = out_r[15]; np_pad->nl[17] = out_l[15];
+    np_pad->net   = true;
+    np_pad->stale = true;
+}
